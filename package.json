{
  "name": "design-system-starter",
  "private": true,
  "version": "0.0.0",
  "description": "Template monorepo pour industrialiser un Design System",
  "scripts": {
    "dev": "turbo run dev --filter=@brique-rouge/storybook",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "tokens": "turbo run build --filter=@brique-rouge/tokens",
    "figma:publish": "figma connect publish",
    "figma:unpublish": "figma connect unpublish"
  },
  "devDependencies": {
    "axe-core": "4.11.1",
    "playwright": "1.63.0",
    "prettier": "^3.2.0",
    "turbo": "^2.11.10",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1"
}
